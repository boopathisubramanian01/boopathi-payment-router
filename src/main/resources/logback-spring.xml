<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context" name="appName"    source="spring.application.name" defaultValue="payment-router"/>
    <springProperty scope="context" name="activeProfile" source="spring.profiles.active" defaultValue="default"/>

    <!-- ── Log pattern ───────────────────────────────────────────────────────
         %d               ISO timestamp
         %-5level         Log level (left-padded to 5 chars)
         [${appName}]     Service name from application.properties
         [%t]             Thread name
         [traceId=%X{traceId:-N/A}]     MDC trace/correlation ID
         [paymentId=%X{paymentId:-N/A}] MDC payment ID
         [routerId=%X{routerId:-N/A}]   MDC router-specific ID
         %logger{40}      Logger class (max 40 chars, abbreviated)
         %msg%n           Log message + newline
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${appName}] [%t] [traceId=%X{traceId:-N/A}] [paymentId=%X{paymentId:-N/A}] [routerId=%X{routerId:-N/A}] %logger{40} - %msg%n"/>

    <!-- Coloured console pattern -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%cyan(${appName})] [%thread] [traceId=%yellow(%X{traceId:-N/A})] [paymentId=%green(%X{paymentId:-N/A})] [routerId=%magenta(%X{routerId:-N/A})] %logger{40} - %msg%n"/>

    <!-- ── Console appender ──────────────────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ── Rolling file appender ─────────────────────────────────────────── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${appName}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover; keep 30 days, max 500 MB total -->
            <fileNamePattern>logs/${appName}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>50MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ── Logger levels ─────────────────────────────────────────────────── -->
    <logger name="com.payment.router" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Quieten noisy framework loggers -->
    <logger name="org.springframework"          level="INFO"/>
    <logger name="org.springframework.kafka"    level="WARN"/>
    <logger name="org.apache.kafka"             level="WARN"/>

    <!-- ── Root logger ───────────────────────────────────────────────────── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
